# ---- Server ----
NODE_ENV=development
HOST=127.0.0.1          # use 0.0.0.0 to open the app from a phone on your LAN
PORT=3000

# ---- Database Provider (sqlite | postgres) ----
DB_PROVIDER=sqlite
DB_FILE=database/data/waretrack.db
# For Amazon RDS PostgreSQL:
# DB_PROVIDER=postgres
# DATABASE_URL=postgres://<username>:<password>@<rds-endpoint>:5432/<dbname>

STORAGE_PROVIDER=local
STORAGE_DIR=database/data/files
AUTH_PROVIDER=local
EVENTS_PROVIDER=local
NOTIFICATIONS_PROVIDER=local
# For Amazon SNS (Email / SMS alerts):
# NOTIFICATIONS_PROVIDER=sns
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:waretrack3d-alerts
JOBS_PROVIDER=local
SYNC_PROVIDER=local

# ---- Amazon S3 Storage Configuration (set STORAGE_PROVIDER=s3 to activate) ----
# STORAGE_PROVIDER=s3
# S3_BUCKET=your-waretrack-s3-bucket
# S3_PREFIX=uploads/
# AWS_REGION=ap-south-1
# CLOUDFRONT_URL=https://dxxxxxxxxxxxx.cloudfront.net
# Optional: explicitly provide keys if not using IAM instance role
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Behaviour ----
AUTO_SEED=true                  # create + seed the DB on first start when it is empty
SESSION_TTL_HOURS=12
VEHICLE_RETURN_DELAY_MS=20000   # how long a delivered vehicle takes to drive back to the yard
SYNC_INTERVAL_MS=300000         # snapshot sync every 5 minutes (see Step 4 of the reference guide)
CORS_ORIGIN=                    # leave empty for same-origin only
